FROM mysql:8.0

# Definir variáveis de ambiente (modifique conforme necessário)
ENV MYSQL_ROOT_PASSWORD=abc123456
ENV MYSQL_DATABASE=xiaozhi
ENV MYSQL_USER=xiaozhi
ENV MYSQL_PASSWORD=123456

# Definir charset e collation
ENV LANG=C.UTF-8
ENV MYSQL_CHARSET=utf8mb4
ENV MYSQL_COLLATION=utf8mb4_unicode_ci

# Copiar arquivos SQL para o diretório de inicialização
COPY db/init.sql /docker-entrypoint-initdb.d/