# Use Eclipse Temurin for both build and runtime stages
FROM eclipse-temurin:21-jdk AS builder

# Argumentos de build
# Tamanho do modelo Vosk: small(~50MB) ou standard(~1.3GB)
ARG VOSK_MODEL_SIZE=small
# Modelo TTS local, padrão vits-melo-tts-zh_en (chinês/inglês); defina como none para não baixar
ARG TTS_MODEL=vits-melo-tts-zh_en
# Proxy para download de modelos (usado apenas pelo curl, não afeta o apt-get)
ARG DOWNLOAD_PROXY=

# Instalar ferramentas de build necessárias
RUN apt-get update && apt-get install -y --no-install-recommends \
    maven \
    wget \
    unzip \
    curl \
    lbzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copiar o repositório local do projeto (dependências como sherpa-onnx, não publicadas no Maven Central)
COPY repo/ ./repo/

# Copiar primeiro todos os pom.xml para aproveitar o cache do Docker (pula o download quando as dependências não mudam)
COPY pom.xml ./
COPY xiaozhi-common/pom.xml  ./xiaozhi-common/
COPY xiaozhi-service/pom.xml ./xiaozhi-service/
COPY xiaozhi-ai/pom.xml      ./xiaozhi-ai/
COPY xiaozhi-dialogue/pom.xml ./xiaozhi-dialogue/
COPY xiaozhi-server/pom.xml  ./xiaozhi-server/

# Pré-baixar dependências (camada separada; não é baixado novamente quando o código-fonte muda)
RUN mvn -Dmaven.repo.local=/root/.m2/repository dependency:go-offline -DexcludeGroupIds=com.xiaozhi || true

# Copiar o código-fonte de todos os módulos
COPY xiaozhi-common/src  ./xiaozhi-common/src
COPY xiaozhi-service/src ./xiaozhi-service/src
COPY xiaozhi-ai/src      ./xiaozhi-ai/src
COPY xiaozhi-dialogue/src ./xiaozhi-dialogue/src
COPY xiaozhi-server/src  ./xiaozhi-server/src

# Compilar todo o projeto multi-módulo
RUN mvn -Dmaven.repo.local=/root/.m2/repository package -DskipTests

# Extrair o número de versão do projeto (do xiaozhi-parent no pom raiz)
RUN APP_VERSION=$(mvn -q -Dexec.executable=echo -Dexec.args='${project.version}' --non-recursive exec:exec 2>/dev/null || \
        grep '<version>' pom.xml | head -3 | tail -1 | sed -e 's/.*<version>//' -e 's/<\/version>.*//' -e 's/[[:space:]]//g') && \
    echo "APP_VERSION=${APP_VERSION}" > /build/app_version.env && \
    cat /build/app_version.env

# ============================================================
# Baixar modelos e bibliotecas nativas
# O script pula automaticamente arquivos já existentes, com suporte a cache do Docker
# ============================================================
COPY scripts/ ./scripts/

RUN mkdir -p /build/models /build/lib && \
    echo ">>> Baixando bibliotecas nativas e modelo VAD ..." && \
    http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
        TARGET_PLATFORM=linux-x64 bash scripts/download_base.sh all && \
    echo ">>> Baixando modelo Vosk STT (${VOSK_MODEL_SIZE}) ..." && \
    http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
        bash scripts/download_stt.sh "$VOSK_MODEL_SIZE" && \
    if [ "$TTS_MODEL" != "none" ] && [ -n "$TTS_MODEL" ]; then \
        echo ">>> Baixando modelo TTS (${TTS_MODEL}) ..." && \
        case "$TTS_MODEL" in \
            matcha-icefall-zh-en) \
                http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
                    bash scripts/download_tts.sh matcha ;; \
            *) \
                http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
                    bash scripts/download_tts.sh vits-melo ;; \
        esac; \
    else \
        echo ">>> Pulando download do modelo TTS (TTS_MODEL=none)"; \
    fi && \
    bash scripts/download_models.sh status

# ============================================================
# Imagem base de runtime compartilhada
# ============================================================
FROM eclipse-temurin:21-jre AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxfixes3 \
    libxtst6 \
    libxrender1 \
    libpulse0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/app_version.env /app/
COPY --from=builder /build/models /app/models
COPY --from=builder /build/lib /app/lib
ENV LD_LIBRARY_PATH=/app/lib:$LD_LIBRARY_PATH

# ============================================================
# xiaozhi-server (API do painel administrativo, porta 8091)
# Build: docker build --target server ...
# ============================================================
FROM runtime-base AS server

COPY --from=builder /build/xiaozhi-server/target/xiaozhi-server-*.jar /app/

RUN echo '#!/bin/bash\n\
if [ -f /app/app_version.env ]; then\n\
  . /app/app_version.env\n\
fi\n\
echo "Starting xiaozhi-server ${APP_VERSION}"\n\
java -Xms512m -Xmx1024m \\\n\
  -Dsherpa_onnx.native.path=/app/lib \\\n\
  -Djava.library.path=/app/lib \\\n\
  -jar /app/xiaozhi-server-${APP_VERSION}.jar\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/bin/bash", "/app/start.sh"]

# ============================================================
# xiaozhi-dialogue (serviço de diálogo do dispositivo, porta 8092)
# Build: docker build --target dialogue ...
# ============================================================
FROM runtime-base AS dialogue

COPY --from=builder /build/xiaozhi-dialogue/target/xiaozhi-dialogue-*-exec.jar /app/

RUN echo '#!/bin/bash\n\
if [ -f /app/app_version.env ]; then\n\
  . /app/app_version.env\n\
fi\n\
echo "Starting xiaozhi-dialogue ${APP_VERSION}"\n\
java -Xms512m -Xmx1024m \\\n\
  -Dsherpa_onnx.native.path=/app/lib \\\n\
  -Djava.library.path=/app/lib \\\n\
  -jar /app/xiaozhi-dialogue-${APP_VERSION}-exec.jar\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/bin/bash", "/app/start.sh"]
